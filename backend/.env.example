# Environment variables for the Python AI backend
# Copy to .env and adjust values before starting the server
APP_NAME=drone-simulacao-ai
ENVIRONMENT=development
API_PREFIX=/api
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DRONE_MAX_SPEED=12.0
DRONE_MAX_ALTITUDE=120.0
DRONE_MIN_ALTITUDE=5.0
BATTERY_WARNING_LEVEL=25
